# {{ ansible_managed }}
# rclone remotes for resticprofile, read through env-file in profiles.yaml

# Garage on mediaserver
RCLONE_CONFIG_GARAGE_TYPE=s3
RCLONE_CONFIG_GARAGE_PROVIDER=Other
RCLONE_CONFIG_GARAGE_ENDPOINT=http://mediaserver.{{ local_domain }}:3900
RCLONE_CONFIG_GARAGE_REGION=garage
RCLONE_CONFIG_GARAGE_FORCE_PATH_STYLE=true
RCLONE_CONFIG_GARAGE_ACCESS_KEY_ID={{ garage_plex_key_id }}
RCLONE_CONFIG_GARAGE_SECRET_ACCESS_KEY={{ garage_plex_secret_key }}

# Backblaze B2 
RCLONE_CONFIG_B2_TYPE=b2
RCLONE_CONFIG_B2_ACCOUNT={{ b2_plex_key_id }}
RCLONE_CONFIG_B2_KEY={{ b2_plex_app_key }}
RCLONE_CONFIG_B2_HARD_DELETE=true