# =============================================================================
# Plex metadata: big and replaceable, Garage only, Plex keeps running
# =============================================================================
plex-metadata-garage:
  inherit: base
  repository: "rclone:garage:cobalt-plex-metadata"
  backup:
    schedule: "04:30"
    source:
      - "{{ plex_data_dir }}"
    exclude:
      - "{{ plex_data_dir }}/Plug-in Support/Databases/com.plexapp.plugins.library*"   # in cobalt-plex
      - "{{ plex_data_dir }}/Cache"
      - "{{ plex_data_dir }}/Codecs"
      - "{{ plex_data_dir }}/Crash Reports"
      - "{{ plex_data_dir }}/Diagnostics"
      - "{{ plex_data_dir }}/Drivers"
      - "{{ plex_data_dir }}/Logs"
      - "{{ plex_data_dir }}/Logs.old"
      - "{{ plex_data_dir }}/Updates"
    tag:
      - plex-metadata
  check:
    schedule: "Mon 06:00"