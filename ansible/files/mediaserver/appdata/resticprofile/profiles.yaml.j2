{#
  resticprofile config, rendered by Ansible.
  Ansible Jinja: {{ var }}, {% ... %}   resticprofile Go templates: wrap in {% raw %}...{% endraw %}

  Bucket names are identical on every destination; only the rclone remote differs:
    shared apps:  rclone:<dest>:cobalt-apps
    vaultwarden:  rclone:<dest>vault:cobalt-vaultwarden

  Run these commands to initialize new repositories and verify that they are empty:
  docker exec resticprofile resticprofile apps-<dest>.init
  docker exec resticprofile resticprofile apps-<dest>.snapshots   # empty list, no error = OK
  

  Secrets (/run/secrets):
    restic_remotes_env      rclone remotes: garage, b2                (shared keys)
    restic_vaultwarden_env  rclone remotes: garagevault, b2vault      (Vaultwarden-only keys)
    restic_vaultwarden_key  restic password, Vaultwarden repositories
    restic_apps_key         restic password, shared apps repositories
#}
{# Regular apps: plain file copy #}
{% set apps = ['sonarr', 'radarr', 'prowlarr', 'bazarr', 'qbt-public', 'qbt-private', 'qbt-books', 'syncthing'] %}
{# Apps with live SQLite databases: each db is copied with sqlite3 .backup before the backup #}
{% set sqlite_apps = ['actualbudget', 'uptime-kuma', 'ombi', 'organizr', 'beets'] %}
{# Apps without a container to stop/start on restore (run as one-off commands) #}
{% set no_container = ['beets'] %}

{# resticprofile's own template variable for the running profile's name; Ansible outputs it as literal text #}
{% set profile = '{{ .Profile.Name }}' %}

{% set destinations = ['garage', 'b2'] %}
{% set backup_time = '03:00' %}
{% set prune_time = 'Sun 05:00' %}
{% set check_time = 'Mon 05:00' %}

version: "1"

global:
  # supercronic reads this crontab; /tmp is writable by uid 1000 and rebuilt on each start
  scheduler: "crontab:-:/tmp/crontab"
  priority: low

# =============================================================================
# Base: shared by every profile. Not scheduled.
# =============================================================================
base:
  initialize: true
  cache-dir: /cache
  retry-lock: 30m          # wait for a locked repository instead of failing
  env-file: /run/secrets/restic_remotes_env
  env:
    RCLONE_LOG_LEVEL: ERROR   # hide rclone NOTICE lines (missing config file, lock lookups)

  backup:
    schedule-permission: user
    schedule-lock-wait: 1h
    send-after:
      method: GET
      url: "http://uptime-kuma:3001/api/push/{{ kuma_backups_token }}?status=up&msg={{ profile }}+backup+ok"
    send-after-fail:
      method: GET
      url: "http://uptime-kuma:3001/api/push/{{ kuma_backups_token }}?status=down&msg={{ profile }}+backup+FAILED"

  check:
    schedule-permission: user
    send-after:
      method: GET
      url: "http://uptime-kuma:3001/api/push/{{ kuma_checks_token }}?status=up&msg={{ profile }}+check+ok"
    send-after-fail:
      method: GET
      url: "http://uptime-kuma:3001/api/push/{{ kuma_checks_token }}?status=down&msg={{ profile }}+check+FAILED"

  prune:
    schedule-permission: user
    send-after:
      method: GET
      url: "http://uptime-kuma:3001/api/push/{{ kuma_checks_token }}?status=up&msg={{ profile }}+prune+ok"
    send-after-fail:
      method: GET
      url: "http://uptime-kuma:3001/api/push/{{ kuma_checks_token }}?status=down&msg={{ profile }}+prune+FAILED"

  retention:
    after-backup: true
    keep-daily: 7
    keep-weekly: 4
    keep-monthly: 6
    prune: true             # own-repository profiles prune after backup; shared-repo apps override this
    tag: true
    group-by: "host,tags"   # group snapshots by tag, not by exact paths

# =============================================================================
# Vaultwarden: own repositories and keys on every destination
# =============================================================================
vaultwarden:
  inherit: base
  password-file: /run/secrets/restic_vaultwarden_key
  env-file:
    - /run/secrets/restic_remotes_env
    - /run/secrets/restic_vaultwarden_env

  backup:
    run-before:
      - echo "==> [{{ profile }}] copying live database"
      - >-
        sqlite3 /appdata/vaultwarden/db.sqlite3
        ".backup '/staging/{{ profile }}-db.sqlite3'" ||
        { echo "!! [{{ profile }}] database copy failed, backup aborted" >&2; exit 1; }
      - echo "==> [{{ profile }}] backing up /appdata/vaultwarden"
    run-after:
      - echo "==> [{{ profile }}] backup complete"
    run-after-fail:
      - 'echo "!! [{{ profile }}] BACKUP FAILED: $ERROR_MESSAGE"'
    source:
      - /appdata/vaultwarden
      - "/staging/{{ profile }}-db.sqlite3"
    exclude:
      - db.sqlite3*     # live db + -wal/-shm; the copy above is used instead
      - icon_cache
    tag:
      - vaultwarden
  ls:
    tag:
      - vaultwarden
  restore:
    target: /staging/restore/vaultwarden
    tag:
      - vaultwarden
    run-before:
      - echo "==> [vaultwarden] stopping container"
      # 204 = stopped, 304 = already stopped; both succeed
      - curl -fsS -X POST http://socket-proxy:2375/containers/vaultwarden/stop
      - rm -rf /staging/restore/vaultwarden
      - echo "==> [vaultwarden] restoring snapshot into /staging/restore/vaultwarden"
    run-after:
      - echo "==> [vaultwarden] checking database copy"
      - >-
        test "$(sqlite3 '/staging/restore/vaultwarden/staging/{{ profile }}-db.sqlite3' 'PRAGMA integrity_check;')" = ok ||
        { echo "!! [vaultwarden] database copy missing or damaged, live data left untouched" >&2; exit 1; }
      - echo "==> [vaultwarden] replacing /appdata/vaultwarden"
      - find /appdata/vaultwarden -mindepth 1 -delete
      - cp -a /staging/restore/vaultwarden/appdata/vaultwarden/. /appdata/vaultwarden/
      - >-
        cp '/staging/restore/vaultwarden/staging/{{ profile }}-db.sqlite3'
        /appdata/vaultwarden/db.sqlite3
      - echo "==> [vaultwarden] starting container"
      - curl -fsS -X POST http://socket-proxy:2375/containers/vaultwarden/start
      - echo "==> [vaultwarden] restore complete"
    run-after-fail:
      - 'echo "!! [vaultwarden] RESTORE FAILED: $ERROR_MESSAGE. Container left stopped."'

{% for dest in destinations %}
vaultwarden-{{ dest }}:
  inherit: vaultwarden
  repository: "rclone:{{ dest }}vault:cobalt-vaultwarden"
  backup:
    schedule: "{{ backup_time }}"
  check:
    read-data-subset: "5%"
    schedule: "{{ check_time }}"

{% endfor %}

# =============================================================================
# Regular apps: shared repository per destination, separated by tags
# =============================================================================
apps-common:
  inherit: base
  initialize: false # Manually initialize the shared repository once per destination
  password-file: /run/secrets/restic_apps_key
  retention:
    prune: false    # forget only; pruning the shared repository is done by apps-<dest>


{% for app in apps + sqlite_apps %}
{{ app }}:
  inherit: apps-common
  backup:
    skip-if-unchanged: true
{% if app in sqlite_apps %}
    run-before:
      - echo "==> [{{ profile }}] copying sqlite databases"
      - >-
        rm -rf "/staging/{{ profile }}" && mkdir -p "/staging/{{ profile }}" &&
        find /appdata/{{ app }} -type f \( -name '*.db' -o -name '*.sqlite' -o -name '*.sqlite3' -o -name '*.blb' \) -print0 |
        xargs -0 -r -n1 sh -c 'set -e; d="/staging/{{ profile }}$(dirname "$1")"; mkdir -p "$d";
        echo "    $1"; sqlite3 -cmd ".timeout 30000" "$1" ".backup \"$d/$(basename "$1")\""' _ ||
        { echo "!! [{{ profile }}] sqlite copy failed, backup aborted" >&2; exit 1; }
{% endif %}
    source:
      - /appdata/{{ app }}
{% if app in sqlite_apps %}
      - "/staging/{{ profile }}"
{% endif %}
    exclude:
      # live databases, only under /appdata (the copies in /staging must stay in the backup)
      - "/appdata/**/*.db"
      - "/appdata/**/*.db-shm"
      - "/appdata/**/*.db-wal"
      - "/appdata/**/*.db-journal"
      - "/appdata/**/*.sqlite"
      - "/appdata/**/*.sqlite-shm"
      - "/appdata/**/*.sqlite-wal"
      - "/appdata/**/*.sqlite3"
      - "/appdata/**/*.sqlite3-shm"
      - "/appdata/**/*.sqlite3-wal"
      - "/appdata/**/*.blb"
      - "/appdata/**/*.blb-journal"
      - "*.pid"
      - lockfile
      - logs
      - Logs
      - log
      - .cache
      - cache
      - Sentry            # arr crash reporting
      - MediaCover        # arr poster cache, re-downloaded
      - GeoDB             # qBittorrent GeoIP db, re-downloaded
      - index-v2          # syncthing index, rebuilt automatically
      - "custom-*.d.*"    # empty linuxserver.io leftovers
    tag:
      - {{ app }}
  ls:
    tag:
      - {{ app }}
  restore:
    target: /staging/restore/{{ app }}
    tag:
      - {{ app }}
    run-before:
{% if app not in no_container %}
      - echo "==> [{{ app }}] stopping container"
      # 204 = stopped, 304 = already stopped; both succeed
      - curl -fsS -X POST http://socket-proxy:2375/containers/{{ app }}/stop
{% endif %}
      - rm -rf /staging/restore/{{ app }}
      - echo "==> [{{ app }}] restoring snapshot into /staging/restore/{{ app }}"
    run-after:
      - echo "==> [{{ app }}] checking restored files"
      - >-
        test -n "$(ls -A /staging/restore/{{ app }}/appdata/{{ app }} 2>/dev/null)" ||
        { echo "!! [{{ app }}] nothing restored, live data left untouched" >&2; exit 1; }
{% if app in sqlite_apps %}
      - echo "==> [{{ app }}] checking restored database copies"
      - >-
        [ -n "$(find "/staging/restore/{{ app }}/staging/{{ profile }}" -type f 2>/dev/null)" ] ||
        { echo "!! [{{ app }}] no database copies in this snapshot, live data left untouched" >&2; exit 1; };
        find "/staging/restore/{{ app }}/staging/{{ profile }}" -type f | while read -r f; do
        [ "$(sqlite3 "$f" 'PRAGMA integrity_check;')" = ok ] ||
        { echo "!! [{{ app }}] damaged database copy $f, live data left untouched" >&2; exit 1; }; done
{% endif %}
      - echo "==> [{{ app }}] replacing /appdata/{{ app }}"
      - find /appdata/{{ app }} -mindepth 1 -delete
      - >-
        [ -z "$(ls -A /appdata/{{ app }})" ] ||
        { echo "!! [{{ app }}] could not clear /appdata/{{ app }}, restore stopped" >&2; exit 1; }
      - cp -a /staging/restore/{{ app }}/appdata/{{ app }}/. /appdata/{{ app }}/
{% if app in sqlite_apps %}
      - echo "==> [{{ app }}] putting database copies back"
      - cp -a "/staging/restore/{{ app }}/staging/{{ profile }}/appdata/{{ app }}/." /appdata/{{ app }}/
{% endif %}
{% if app not in no_container %}
      - echo "==> [{{ app }}] starting container"
      - curl -fsS -X POST http://socket-proxy:2375/containers/{{ app }}/start
{% endif %}
      - echo "==> [{{ app }}] restore complete"
    run-after-fail:
      - 'echo "!! [{{ app }}] RESTORE FAILED: $ERROR_MESSAGE. Container left stopped."'

{% endfor %}

# UniFi: only its own .unf autobackups (the live MongoDB can't be copied safely).
# Needs an ACL so uid 1000 can read appdata/unifi/data/backup.
# sudo setfacl -m u:1000:x appdata/unifi appdata/unifi/data
# sudo setfacl -R -m u:1000:rX appdata/unifi/data/backup
# sudo setfacl -R -d -m u:1000:rX appdata/unifi/data/backup
# Restore by hand: copy a .unf out of /staging/restore/unifi and upload it in UniFi's setup wizard.
unifi:
  inherit: apps-common
  backup:
    skip-if-unchanged: true
    source:
      - /appdata/unifi/data/backup/autobackup
    tag:
      - unifi
  ls:
    tag:
      - unifi
  restore:
    target: /staging/restore/unifi
    tag:
      - unifi
    run-before:
      - rm -rf /staging/restore/unifi
    run-after:
      - echo "==> [unifi] .unf files restored under /staging/restore/unifi, copy one out with docker cp and upload it in UniFi"


# =============================================================================
# Apps scheduled backups
# =============================================================================
{% for dest in destinations %}
{% for app in apps + sqlite_apps + ['unifi'] %}
{{ app }}-{{ dest }}:
  inherit: {{ app }}
  repository: "rclone:{{ dest }}:cobalt-apps"
  backup:
    schedule: "{{ backup_time }}"

{% endfor %}
{% endfor %}

# =============================================================================
# Shared apps repository maintenance: one prune + check per destination
# =============================================================================
{% for dest in destinations %}
apps-{{ dest }}:
  inherit: base
  initialize: false
  repository: "rclone:{{ dest }}:cobalt-apps"
  password-file: /run/secrets/restic_apps_key
  prune:
    schedule: "{{ prune_time }}"
  check:
    read-data-subset: "5%"
    schedule: "{{ check_time }}"

{% endfor %}
