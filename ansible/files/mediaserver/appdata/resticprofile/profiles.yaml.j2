# If Ansible templates are required alongside resticprofiles go templates then wrap resticprofiles in {% raw %}…{% endraw %} 
version: "1"

global:
  # supercronic reads this crontab; /tmp is writable by uid 1000 and rebuilt on each start
  scheduler: "crontab:-:/tmp/crontab"
  priority: low

# Shared settings for profiles that back up to Garage
garage:
  initialize: true
  cache-dir: /cache
  env:
    AWS_DEFAULT_REGION: garage
  
  # Every profile reports to the same Kuma push monitors
  backup:
    send-after:
      method: GET
      url: "http://uptime-kuma:3001/api/push/{{ kuma_backups_token }}?status=up&msg={% raw %}{{ .Profile.Name }}{% endraw %}+backup+ok"
    send-after-fail:
      method: GET
      url: "http://uptime-kuma:3001/api/push/{{ kuma_backups_token }}?status=down&msg={% raw %}{{ .Profile.Name }}{% endraw %}+backup+FAILED"
  check:
    send-after:
      method: GET
      url: "http://uptime-kuma:3001/api/push/{{ kuma_checks_token }}?status=up&msg={% raw %}{{ .Profile.Name }}{% endraw %}+check+ok"
    send-after-fail:
      method: GET
      url: "http://uptime-kuma:3001/api/push/{{ kuma_checks_token }}?status=down&msg={% raw %}{{ .Profile.Name }}{% endraw %}+check+FAILED"

vaultwarden:
  inherit: garage
  repository: "s3:http://garage:3900/vaultwarden"
  password-file: /run/secrets/restic_vaultwarden_key
  env-file: /run/secrets/restic_vaultwarden_env

  backup:
    run-before: >-
      sqlite3 /data/vaultwarden/db.sqlite3
      ".backup '/staging/vaultwarden-db.sqlite3'"
    source:
      - /data/vaultwarden
      - /staging/vaultwarden-db.sqlite3
    exclude:
      - /data/vaultwarden/db.sqlite3*     # live db + -wal/-shm; the copy above is used instead
      - /data/vaultwarden/icon_cache
    tag:
      - vaultwarden
    schedule: "03:00"
    schedule-permission: user
    schedule-lock-wait: 1h

  restore:
    target: /staging/restore
    run-before:
      # Stop Vaultwarden (204 = stopped, 304 = already stopped; both succeed)
      - curl -fsS -X POST http://socket-proxy:2375/containers/vaultwarden/stop
      - rm -rf /staging/restore
    run-after:
      - >-
        test "$(sqlite3 /staging/restore/staging/vaultwarden-db.sqlite3 'PRAGMA integrity_check;')" = ok
      - find /data/vaultwarden -mindepth 1 -delete
      - cp -a /staging/restore/data/vaultwarden/. /data/vaultwarden/
      - cp /staging/restore/staging/vaultwarden-db.sqlite3 /data/vaultwarden/db.sqlite3
      - curl -fsS -X POST http://socket-proxy:2375/containers/vaultwarden/start
    run-after-fail:
      - 'echo "Restore FAILED: $ERROR_MESSAGE. Vaultwarden left stopped."'

  check:
    read-data-subset: "5%"
    schedule: "Sun 04:00"
    schedule-permission: user

  retention:
    after-backup: true
    keep-daily: 7
    keep-weekly: 4
    keep-monthly: 6
    prune: true
    tag: true
