# {{ ansible_managed }}
[Unit]
Description=Claude Code Remote Control server
Wants=network-online.target
After=network-online.target squid.service AdGuardHome.service
StartLimitIntervalSec=0

[Service]
Type=simple
User={{ sandbox_user }}
Group={{ sandbox_user }}
WorkingDirectory={{ sandbox_claude_code_workspace }}
EnvironmentFile=-/etc/claude-code/github.env
ExecStart=/usr/bin/claude remote-control --spawn same-dir --name {{ sandbox_claude_code_remote_control_name }} --permission-mode {{ sandbox_claude_code_remote_control_mode }}
Restart=always
RestartSec=30
OOMPolicy=continue
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target