{
  "permissions": {
    "deny": [
      "Read(//opt/**)",
      "Read(//etc/squid/**)",
      "Read(//etc/nftables.conf)",
      "Read(//etc/nftables.d/**)",
      "Read(//var/log/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "credentials": {
      "files": [
        { "path": "~/.claude/.credentials.json", "mode": "deny" }
      ]
    },
    "filesystem": {
      "allowWrite": ["~/.npm", "~/.cache"]
    },
    "network": {
        "allowedDomains": ["github.com", "*.github.com", "*.githubusercontent.com", "registry.npmjs.org"]
    }
  },
  "isolatePeerMachines": true,
  "claudeMd": {{ sandbox_claude_code_md | to_json }},
  "env": {
    "HTTPS_PROXY": "http://{{ sandbox_proxy_host }}:{{ sandbox_proxy_port }}",
    "HTTP_PROXY": "http://{{ sandbox_proxy_host }}:{{ sandbox_proxy_port }}",
    "NO_PROXY": "localhost,127.0.0.1,::1"
  }
}