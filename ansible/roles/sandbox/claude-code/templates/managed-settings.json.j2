{
  "model": "sonnet",
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/etc/claude-code/hooks/post-edit.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/etc/claude-code/hooks/stop-check.sh",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "isolatePeerMachines": true,
  "env": {
    "DISABLE_TELEMETRY": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  }
}