{
  "model": "sonnet",
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Read(//opt/**)",
      "Read(//etc/squid/**)",
      "Read(//etc/nftables.conf)",
      "Read(//etc/nftables.d/**)",
      "Read(//var/log/**)",
      "Read(//etc/claude-code/github.env)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "credentials": {
      "files": [
        { "path": "~/.claude/.credentials.json", "mode": "deny" }
      ]
    },
    "filesystem": {
      "allowWrite": ["~/.npm", "~/.cache", "~/.config/mise", "~/.local/share/mise", "~/.local/state/mise"]
    },
    "network": {
      "allowedDomains": {{ (sandbox_allowlist + (sandbox_allowlist | map('regex_replace', '^', '*.') | list)) | to_json }}
    }
  },
  "isolatePeerMachines": true,
  "env": {
    "HTTPS_PROXY": "http://{{ sandbox_proxy_host }}:{{ sandbox_proxy_port }}",
    "HTTP_PROXY": "http://{{ sandbox_proxy_host }}:{{ sandbox_proxy_port }}",
    "NO_PROXY": "localhost,127.0.0.1,::1",
    "PATH": "/home/{{ sandbox_user }}/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  }
}