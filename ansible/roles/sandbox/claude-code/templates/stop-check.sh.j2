#!/usr/bin/env bash
# Stop: if files changed, run the quality gate before Claude finishes.
# Exit 2 blocks the stop and sends Claude back to fix failures.
set -uo pipefail

input=$(cat)
session=$(jq -r '.session_id // "default"' <<<"$input")
marker="${TMPDIR:-/tmp}/claude-dirty-$session"

# Nothing edited since the last passing check: nothing to verify.
[[ -f "$marker" ]] || exit 0

# Already continuing because of this hook: don't loop. The marker stays,
# so the check runs again at the end of the next turn.
[[ "$(jq -r '.stop_hook_active // false' <<<"$input")" == "true" ]] && exit 0

command -v mise >/dev/null 2>&1 || exit 0

# One check per repo touched this turn; stop at the first failure.
while IFS= read -r root; do
  cd "$root" 2>/dev/null || continue
  mise tasks info check >/dev/null 2>&1 || continue
  if ! out=$(mise run check 2>&1); then
    {
      echo "'mise run check' failed in $root. The work is not done until it passes:"
      echo "$out" | tail -n 80
    } >&2
    exit 2
  fi
done < <(sort -u "$marker")

rm -f "$marker"
exit 0