# {{ ansible_managed }}
http:
  middlewares:
    chain-redirect:
      chain:
        middlewares:
          - crowdsec
          - middleware-local-redirect
          - middlewares-https-redirectscheme

    chain-no-auth:
      chain:
        middlewares:
          - crowdsec
          - middlewares-rate-limit
          - middlewares-https-redirectscheme
          - middlewares-secure-headers
          - middlewares-compress

    chain-basic-auth:
      chain:
        middlewares:
          - crowdsec
          - middlewares-rate-limit
          - middlewares-https-redirectscheme
          - middlewares-secure-headers
          - middlewares-basic-auth
          - middlewares-compress

    chain-oauth:
      chain:
        middlewares:
          - crowdsec
          - middlewares-rate-limit
          - middlewares-https-redirectscheme
          - middlewares-secure-headers
          - middlewares-oauth-errors
          - middlewares-oauth
          - middlewares-compress

    chain-oauth-admin:
      chain:
        middlewares:
          - crowdsec
          - middlewares-rate-limit
          - middlewares-https-redirectscheme
          - middlewares-secure-headers
          - middlewares-oauth-errors
          - middlewares-oauth-admin
          - middlewares-compress

    chain-authelia:
      chain:
        middlewares:
          - crowdsec
          - middlewares-rate-limit
          - middlewares-https-redirectscheme
          - middlewares-secure-headers
          - middlewares-authelia
          - middlewares-compress